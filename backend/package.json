{
	"name": "qb-challenge-backend",
	"version": "1.0.0",
	"description": "Backend for QB Challenge",
	"scripts": {
		"dev": "ts-node-dev --respawn --transpile-only index.ts",
		"test": "cross-env NODE_ENV=test jest --runInBand"
	},
	"dependencies": {
		"express": "^5.1.0",
		"mysql2": "^3.15.3",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/express": "^4.17.25",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.19.25",
		"@types/supertest": "^6.0.3",
		"cross-env": "^10.1.0",
		"jest": "^30.2.0",
		"supertest": "^7.1.4",
		"ts-jest": "^29.4.5",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.9.3"
	},
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "node",
		"moduleFileExtensions": [
			"ts",
			"js"
		],
		"testMatch": [
			"**/*.test.ts"
		]
	}
}
